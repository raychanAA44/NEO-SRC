{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "HUB NEO Gateway",
  "version": "1.1.0",
  "gateway": {
    "host": "0.0.0.0",
    "port": 8888,
    "health_path": "/health",
    "ui_path": "/"
  },
  "default_upstream": "kswa-cloud",
  "upstreams": [
    {
      "id": "hub-ng-master",
      "name": "Local Hub-NG Master Ledger",
      "target": "http://127.0.0.1:8795",
      "health_check": "http://127.0.0.1:8795/health",
      "weight": 0,
      "status": "retired",
      "note": "2026-10-24 按用户指令下线；容器/数据卷/配置保留，可回滚"
    },
    {
      "id": "kswa-cloud",
      "name": "Cloud KSWA Overseas Gateway",
      "target": "https://gateway.example.invalid",
      "health_check": "https://gateway.example.invalid/health",
      "weight": 100,
      "status": "active",
      "note": "当前 8888 数据面上游；token 由运维区/configs/upstream.json 指向外部 secrets.json"
    }
  ],
  "forbidden_ports": [8792]
}
